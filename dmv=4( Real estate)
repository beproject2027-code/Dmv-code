
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns

# 1. Load Dataset
df = pd.read_csv(r'C:\Users\HP\Downloads\house_data.csv')

print("First 5 Records:")
print(df.head())

print("\nDataset Shape:")
print(df.shape)

# 2. Clean Column Names
df.columns = df.columns.str.strip()
df.columns = df.columns.str.replace(' ', '_')

print("\nColumn Names:")
print(df.columns)

# 3. Handle Missing Values
print("\nMissing Values:")
print(df.isnull().sum())

# Fill missing numerical values with mean
df = df.fillna(df.mean(numeric_only=True))

# Fill missing categorical values with mode
for col in df.select_dtypes(include='object').columns:
    if df[col].isnull().any():
        df[col] = df[col].fillna(df[col].mode()[0])

print("\nMissing Values After Cleaning:")
print(df.isnull().sum())

# 4. Remove Duplicate Records
print("\nDuplicate Records:")
print(df.duplicated().sum())

df = df.drop_duplicates()

print("Shape After Removing Duplicates:")
print(df.shape)

# 5. Filter Data
# Houses with price greater than 500000
expensive = df[df['price'] > 500000]

print("\nExpensive Houses:")
print(expensive.head())

# Houses with 3 bedrooms
bedrooms = df[df['bedrooms'] == 3]

print("\nHouses with 3 Bedrooms:")
print(bedrooms.head())

# 6. Data Encoding

# Convert date into date format
df['date'] = pd.to_datetime(df['date'], format='%Y%m%dT%H%M%S')

# One-Hot Encoding of zipcode
df = pd.get_dummies(df, columns=['zipcode'],
                    drop_first=True, dtype=int)

print("\nDataset After Encoding:")
print(df.head())

# 7. Data Aggregation

# Average price by bedrooms
avg_price = df.groupby('bedrooms')['price'].mean()

print("\nAverage Price by Bedrooms:")
print(avg_price)

# Average price by zipcode
# Use the original zipcode before encoding if needed.
# Here, group by bedrooms for simple aggregation.

# 8. Handle Outliers using IQR
Q1 = df['price'].quantile(0.25)
Q3 = df['price'].quantile(0.75)

IQR = Q3 - Q1

lower = Q1 - 1.5 * IQR
upper = Q3 + 1.5 * IQR

df = df[(df['price'] >= lower) & (df['price'] <= upper)]

print("\nShape After Removing Outliers:")
print(df.shape)

# 9. Data Visualization

# Histogram
plt.hist(df['price'], bins=20)
plt.title("House Price Distribution")
plt.xlabel("Price")
plt.ylabel("Frequency")
plt.show()

# Boxplot
sns.boxplot(x=df['price'])
plt.title("House Price Outliers")
plt.show()

# Bar Chart
avg_price = df.groupby('bedrooms')['price'].mean()

avg_price.plot(kind='bar')
plt.title("Average Price by Bedrooms")
plt.xlabel("Number of Bedrooms")
plt.ylabel("Average Price")
plt.show()

# 10. Save Cleaned Dataset
df.to_csv("Cleaned_RealEstate.csv", index=False)

print("\nCleaned Dataset Saved Successfully!")
