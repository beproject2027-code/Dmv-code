#--------------------DMV 1=Data Loading, Storage and File Formats 

# Import libraries
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns

# 1. Load original CSV dataset
df = pd.read_csv(r'C:\Users\HP\Downloads\Superstore.csv', encoding='latin1')

print("Original CSV Data:")
print(df.head())

# 2. Create Excel and JSON versions
df.to_excel('Superstore.xlsx', index=False)
df.to_json('Superstore.json', orient='records')

# 3. Load data from different file formats
csv_data = pd.read_csv(r'C:\Users\HP\Downloads\Superstore.csv', encoding='latin1')
excel_data = pd.read_excel('Superstore.xlsx')
json_data = pd.read_json('Superstore.json')

print("\nCSV Data:")
print(csv_data.head())

print("\nExcel Data:")
print(excel_data.head())

print("\nJSON Data:")
print(json_data.head())

# 4. Explore dataset
print("\nDataset Information:")
print(df.info())

print("\nStatistical Summary:")
print(df.describe())

# 5. Check missing values and duplicates
print("\nMissing Values:")
print(df.isnull().sum())

print("\nDuplicate Records:")
print(df.duplicated().sum())

# 6. Clean data
csv_data = csv_data.drop_duplicates()
csv_data = csv_data.dropna()
csv_data.columns = csv_data.columns.str.strip()

excel_data = excel_data.drop_duplicates()
excel_data = excel_data.dropna()

json_data = json_data.drop_duplicates()
json_data = json_data.dropna()

# 7. Combine all datasets
combined_data = pd.concat(
    [csv_data, excel_data, json_data],
    ignore_index=True
)

# Remove duplicate records
combined_data = combined_data.drop_duplicates()

print("\nCombined Dataset:")
print(combined_data.head())

# 8. Transform data
# Calculate total sales using existing Sales column
combined_data['Total_Sales'] = combined_data['Sales']

print("\nFinal Dataset:")
print(combined_data.head())

# 9. Calculate total sales
total_sales = combined_data['Total_Sales'].sum()
print("\nTotal Sales:", total_sales)

# Calculate average order value
avg_order = combined_data.groupby('Order ID')['Total_Sales'].sum().mean()
print("Average Order Value:", avg_order)

# 10. Product-wise sales
product_sales = combined_data.groupby(
    'Product Name'
)['Total_Sales'].sum()

print("\nProduct-wise Sales:")
print(product_sales)

# 11. Category-wise sales
category_sales = combined_data.groupby(
    'Category'
)['Total_Sales'].sum()

print("\nCategory-wise Sales:")
print(category_sales)

# 12. Find best-selling product
print("\nBest Selling Product:", product_sales.idxmax())

# 13. Bar plot
product_sales.sort_values(ascending=False).head(10).plot(kind='bar')

plt.title("Top 10 Product-wise Sales")
plt.xlabel("Product")
plt.ylabel("Total Sales")
plt.xticks(rotation=45)
plt.tight_layout()
plt.show()

# 14. Pie chart
category_sales.plot(kind='pie', autopct='%1.1f%%')

plt.title("Category-wise Sales")
plt.ylabel("")
plt.show()

# 15. Box plot
sns.boxplot(x=combined_data['Total_Sales'])

plt.title("Sales Distribution")
plt.xlabel("Total Sales")
plt.show()

# 16. Final output
print("\nSales Analysis Completed Successfully!")
