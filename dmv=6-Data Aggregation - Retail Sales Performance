# Import libraries
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

# 1. Load dataset
df = pd.read_csv(r'C:\Users\HP\Downloads\Superstore.csv', encoding='latin1')
# 2. Explore dataset
print("First 5 Records:")
print(df.head())

print("\nDataset Information:")
print(df.info())

print("\nDataset Shape:")
print(df.shape)

# 3. Check required columns
print("\nColumns:")
print(df.columns)

# 4. Region-wise total sales
region_sales = df.groupby('Region')['Sales'].sum()

print("\nRegion-wise Sales:")
print(region_sales)
print(region_sales.index, region_sales.values)

# Bar plot
plt.bar(region_sales.index, region_sales.values)
plt.title("Region-wise Sales")
plt.xlabel("Region")
plt.ylabel("Total Sales")
plt.show()

# Pie chart
plt.pie(region_sales, labels=region_sales.index, autopct='%1.1f%%')
plt.title("Sales Distribution by Region")
plt.show()

# 6. Top-performing region
print("\nTop Performing Region:")
print(region_sales.idxmax())

# 7. Region and Product Category-wise sales
category_sales = df.groupby(['Region', 'Category'])['Sales'].sum()

print("\nRegion and Category-wise Sales:")
print(category_sales)

# 8. Stacked bar plot
category_sales.unstack().plot(kind='bar', stacked=True)
plt.title("Region-wise Product Category Sales")
plt.xlabel("Region")
plt.ylabel("Total Sales")
plt.show()
